# =============================================================================
# RadarPulse — Environment Variables
# Copy this file to .env (web app) or configure via Supabase dashboard (Edge Functions).
# Never commit .env or any file containing real secrets.
# =============================================================================

# =============================================================================
# WEB APP (apps/web) — prefix all with VITE_ for Vite to expose them
# Create apps/web/.env with these values for local development.
# =============================================================================

# Supabase project URL (find it in: Supabase Dashboard > Settings > API)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase anonymous public key (safe to expose in client code)
VITE_SUPABASE_ANON_KEY=eyJ...

# Application display name (optional, defaults to "RadarPulse")
VITE_APP_NAME=RadarPulse

# Stripe — public-facing plan info shown on the subscription page
VITE_STRIPE_PLAN_NAME=RadarPulse Pro
VITE_STRIPE_PLAN_PRICE=99


# =============================================================================
# EDGE FUNCTIONS (supabase/functions) — set via `supabase secrets set` or
# the Supabase Dashboard > Settings > Edge Functions > Secrets
# =============================================================================

# Supabase internal URL (used by Edge Functions to call other functions)
SB_URL=https://<project-ref>.supabase.co

# Supabase service role key — KEEP SECRET, grants full DB access
SERVICE_ROLE_KEY=eyJ...

# Resend API key — used by notify-email to send transactional emails
RESEND_API_KEY=re_...

# "From" address for outgoing emails (must be verified in Resend)
NOTIFY_FROM=noreply@radarpulse.io

# "To" address for internal admin notifications (access requests, etc.)
NOTIFY_TO=team@radarpulse.io

# Frontend URL — used to build magic link URLs in emails
FRONTEND_URL=https://radarpulse.io

# Stripe — server-side keys (keep secret)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# OpenAI — used by AI workspace functions (briefs, scores, prep)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# CORS — restrict API calls to this origin in production
# Defaults to "*" if unset (acceptable for local dev only)
ALLOWED_ORIGIN=https://radarpulse.io

# SAM.gov API key — used by the US opportunities ingestion source
SAMGOV_API_KEY=...

# Internal dispatcher/worker tuning (optional, have defaults)
DISPATCHER_MAX_QUEUED=50
DISPATCHER_STALE_MINUTES=30

# Internal call key for dev/test invocations of protected functions
DEV_CALL_KEY=...
